# ==============================================================================
# AlPrime Capital - Document RAG Assistant Configuration
# ==============================================================================
# Copy this file to `.env` and fill in your LLM API key.
# Qdrant, FastEmbed embeddings, and Cross-Encoder reranking run locally with
# zero external database or embedding API keys required.

# --- Application ---
APP_NAME="AlPrime Document RAG Assistant"
APP_VERSION="1.1.0"
ENVIRONMENT="development"
LOG_LEVEL="INFO"
# Comma-separated allowed browser origins, e.g. "http://localhost:3000,https://app.example.com"
CORS_ALLOW_ORIGINS="*"

# --- LLM Provider Routing ---
# Primary provider for normal questions: "runware" | "gemini" | "groq" | "openai_compatible"
LLM_PROVIDER="runware"
# Providers tried in order if the primary fails (quota, outage, 5xx). Unconfigured ones are skipped.
LLM_FALLBACK_PROVIDERS="gemini,groq"
# Send analytical questions (compare / calculate / why / multi-part) to the reasoning model first.
ENABLE_REASONING_ROUTING=true
REASONING_PROVIDER="runware"
LLM_REASONING_MAX_TOKENS=4096

# Runware running DeepSeek V4.1 Flash (primary + reasoning). Key: https://my.runware.ai
RUNWARE_API_KEY=""
RUNWARE_BASE_URL="https://api.runware.ai/v1"
RUNWARE_MODEL="deepseek:v4.1@flash-1017"
# DeepSeek thinking depth: "low" for simple lookups, "high" for analytical questions ("none" = off).
RUNWARE_NON_REASONING_EFFORT="low"
RUNWARE_REASONING_EFFORT="high"
RUNWARE_MAX_TOKENS=4096

# Google Gemini (first fallback)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"

# Groq running Qwen 27B (second fallback). Get a key at https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_MODEL="qwen/qwen3.8-27b"
# Thinking mode for reasoning questions, instruct mode ("none") for simple lookups.
GROQ_REASONING_EFFORT="default"
GROQ_NON_REASONING_EFFORT="none"

# Any other OpenAI-compatible endpoint (OpenAI, OpenRouter, Runware, Ollama).
# Use it by naming "openai_compatible" in LLM_PROVIDER or LLM_FALLBACK_PROVIDERS.
LLM_API_KEY=""
LLM_BASE_URL="https://api.openai.com/v1"
LLM_MODEL="gpt-4o-mini"

LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=45
# Streaming: abandon a provider that has sent no answer text after this many seconds and fail over.
LLM_FIRST_TOKEN_TIMEOUT_SECONDS=20

# --- Vector Database (Qdrant) ---
# Embedded disk mode is used automatically when QDRANT_URL is blank.
# For Docker Compose sidecar, set QDRANT_URL="http://qdrant:6333".
QDRANT_PATH="./data/qdrant"
QDRANT_URL=""
QDRANT_API_KEY=""
QDRANT_COLLECTION="alprime_documents"

# --- Embeddings & Reranking (Local ONNX via FastEmbed - No API Key Needed) ---
# Lightweight default (~67 MB). Also supports intfloat e.g. "intfloat/multilingual-e5-large".
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"
ENABLE_RERANKER=true
RERANKER_MODEL="Xenova/ms-marco-MiniLM-L-6-v2"

# --- RAG & Anti-Hallucination Guardrails ---
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=10
RERANK_TOP_K=6
MIN_VECTOR_SCORE=0.45
# Cross-encoder gate: off-topic noise scores ~-11; genuine answers can score ~-5.
MIN_RERANK_SCORE=-6.0
MAX_UPLOAD_MB=20
MAX_UPLOAD_FILES=10

# --- API Authentication (Bonus Feature) ---
# Set AUTH_ENABLED=true and a strong random API_KEY to enforce X-API-Key validation.
# The app refuses to start with AUTH_ENABLED=true and the default key.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_ENABLED=false
API_KEY="alprime-dev-key"
